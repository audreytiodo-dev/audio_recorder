# ─────────────────────────────────────────────
# Yeastar P-Series Recording Downloader — Config
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────

# ── Required ──────────────────────────────────

# PBX host — two options:
#   Remote access (depuis n'importe où via internet) :
#     PBX_HOST=your-company.ras.yeastar.com
#     PBX_PORT=443
#     USE_HTTPS=true
#     VERIFY_SSL=true
#   Réseau local uniquement (bureau) :
#     PBX_HOST=192.168.x.x
#     PBX_PORT=8088
#     USE_HTTPS=true
#     VERIFY_SSL=false
PBX_HOST=your-company.ras.yeastar.com

# Client ID from PBX portal: Integrations > API
CLIENT_ID=your_client_id_here

# Client Secret from PBX portal: Integrations > API
CLIENT_SECRET=your_client_secret_here

# Phone number to retrieve recordings for (used by user_recordings.py)
# Leave blank to fetch ALL recordings
TARGET_NUMBER=

# ── Optional ──────────────────────────────────

# PBX API port (443 for RAS remote access, 8088 for local network)
PBX_PORT=443

# Set to true if your PBX uses HTTPS
USE_HTTPS=true

# Local folder to save downloaded recordings
OUTPUT_FOLDER=./recordings/data

# Date range filter — PBX local time, format: YYYY-MM-DD HH:MM:SS
# Leave blank to retrieve all recordings regardless of date
START_TIME=
END_TIME=

# Number of records to fetch per API page
PAGE_SIZE=100

# Number of parallel download threads
# Keep at or below 5 to stay within the PBX's 8-token limit
# Set to 1 if your PBX recording format is .mp3
MAX_WORKERS=5

# Set to true if the PBX has a valid SSL certificate (always true for RAS)
VERIFY_SSL=true

# The PBX ignores start_time/end_time on the search endpoint and returns the
# whole database, which is then filtered locally. With FAST_SEARCH=true the
# search stops paginating once results predate START_TIME (the endpoint sorts
# newest-first), turning ~220 requests into a handful for a recent date range.
# The descending order is verified as it goes; if the PBX stops honouring it,
# the full scan resumes automatically. Set to false to always scan everything.
FAST_SEARCH=true
